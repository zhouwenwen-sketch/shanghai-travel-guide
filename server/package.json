{
  "name": "shanghai-travel-node-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:hotels:bench": "ts-node src/scripts/seed-hotels-bench.ts",
    "db:push:bench": "ts-node src/scripts/bench-schema.ts",
    "bench:hotels:legacy": "ts-node src/scripts/bench-hotels-legacy.ts",
    "bench:hotels:paged": "ts-node src/scripts/bench-hotels-paged.ts",
    "bench:hotels:explain": "ts-node src/scripts/explain-hotels-bench.ts",
    "db:setup": "npm run db:push && npm run prisma:generate && npm run seed",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "mariadb": "3.4.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.2.5",
    "@types/jest": "29.5.14",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "7.10.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.3",
    "ts-jest": "29.2.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
